SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# PostgreSQL connection used by Django
DATABASE_URL=postgresql://lifebudget:change-this-password@db:5432/lifebudget
# Bootstrap credentials used only by the local PostgreSQL container
POSTGRES_DB=lifebudget
POSTGRES_USER=lifebudget
POSTGRES_PASSWORD=change-this-password
# Optional: AI expense audit (server-side only)
AI_BASE_URL=https://factory.marshub.uz/v1
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
